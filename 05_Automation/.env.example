# Opis zmiennych środowiskowych automatyzacji. Plik NIE jest ładowany automatycznie.
# Ustaw zmienne w bieżącej sesji terminala (PowerShell: $env:NAZWA='wartość').
# Nie zapisuj prawdziwego hasła w żadnym pliku ani w Git.

# Adres SUT (domyślnie publiczna instancja)
BASE_URL=https://automationintesting.online
# Kanał przeglądarki dla testów UI: chrome (zainstalowany Google Chrome) albo chromium
BROWSER_CHANNEL=chrome
# Strefa czasowa kontekstu przeglądarki
TEST_TIMEZONE=Europe/Warsaw
# Dane szkoleniowego administratora z sekcji Login oficjalnego repozytorium:
# https://github.com/mwinteringham/restful-booker-platform#login
QA_USERNAME=
QA_PASSWORD=
